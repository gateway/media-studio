#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/shared_env.sh
. "$SCRIPT_DIR/shared_env.sh"
ROOT="${MEDIA_ROOT:-$(media_root_from_script "${BASH_SOURCE[0]}")}"
load_media_env "$ROOT"
KIE_ROOT="$(resolve_kie_root "$ROOT")"
VENV_PY="$KIE_ROOT/.venv/bin/python"
VENV_PIP="$KIE_ROOT/.venv/bin/pip"

if [[ ! -x "$ROOT/node_modules/.bin/vitest" ]]; then
  echo "Installing root development Node tooling for quality gates ..."
  (
    cd "$ROOT"
    npm install
  )
fi

# Bash time reports real/user/sys for each gate without changing its exit status.
TIMEFORMAT='quality timing: %R real, %U user, %S sys'
(cd "$ROOT" && time npm run lint:full)
node --test "$ROOT/scripts/check_admin_theme.test.mjs"
node "$ROOT/scripts/check_admin_theme.mjs"

"$VENV_PY" "$ROOT/scripts/check_repo_hygiene.py"
"$VENV_PY" "$ROOT/scripts/check_storyboard_recipe_genericity.py"
"$VENV_PY" "$ROOT/scripts/check_file_size_guardrails.py"
"$VENV_PY" "$ROOT/scripts/check_style_drift.py"

time "$VENV_PIP" install -q -e "$ROOT/apps/api[dev]"

(
  cd "$ROOT/apps/api"
  pytest_command=("$VENV_PY" -m pytest -q --durations=20 tests)
  if [[ -n "${MEDIA_STUDIO_CI_PROFILE_DIR:-}" ]]; then
    mkdir -p "$MEDIA_STUDIO_CI_PROFILE_DIR"
    pytest_command=("$VENV_PY" "$ROOT/scripts/ci_pytest_profile.py"
      "$MEDIA_STUDIO_CI_PROFILE_DIR/backend.json"
      -q --durations=0 --durations-min=0
      "--junitxml=$MEDIA_STUDIO_CI_PROFILE_DIR/backend-junit.xml" tests)
  fi
  time MEDIA_STUDIO_DB_PATH="${MEDIA_STUDIO_DB_PATH:-$ROOT/data/media-studio.db}" \
  MEDIA_STUDIO_DATA_ROOT="${MEDIA_STUDIO_DATA_ROOT:-$ROOT/data}" \
  MEDIA_STUDIO_KIE_API_REPO_PATH="${MEDIA_STUDIO_KIE_API_REPO_PATH:-$KIE_ROOT}" \
  "${pytest_command[@]}"
)

cd "$ROOT"
time npm --workspace apps/web run test
time npm --workspace apps/web run lint
time npm --workspace apps/web run typecheck
time npm --workspace apps/web run build
time MEDIA_STUDIO_KIE_API_REPO_PATH="$KIE_ROOT" npm run smoke:studio
