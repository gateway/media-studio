{
  "name": "media-studio",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "1.0.8",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup:mac": "./scripts/onboard_mac.sh",
    "desktop:install:mac": "node ./scripts/install_desktop_mac.mjs",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\onboard_windows.ps1",
    "setup:linux": "./scripts/onboard_linux.sh",
    "setup:shared-env": "./scripts/setup_shared_env.sh",
    "generate:api-specs": "./scripts/with_shared_python.sh ./scripts/generate_api_specs.py",
    "quality": "./scripts/run-quality-gates",
    "quality:assistant-ci": "bash ./scripts/run-media-assistant-ci-gate",
    "quality:file-size": "python3 ./scripts/check_file_size_guardrails.py",
    "quality:theme-drift": "python3 ./scripts/check_style_drift.py",
    "release:verify": "./scripts/run-release-gates",
    "release:verify:full": "./scripts/run-full-release-gates",
    "db:backup": "./scripts/backup_db.sh",
    "db:migration-status": "./scripts/migration_status.sh",
    "db:clean": "./scripts/create_clean_db.sh --output ./data/backups/media-studio-clean.sqlite --overwrite",
    "start:api": "node ./scripts/dev_api.mjs --no-reload",
    "dev:api": "node ./scripts/dev_api.mjs",
    "dev:web": "node ./scripts/web_app.mjs --mode dev",
    "start:web": "node ./scripts/web_app.mjs --mode start",
    "build": "npm run build:web",
    "dev": "node ./scripts/run_studio.mjs",
    "start": "npm run start:studio",
    "start:studio": "node ./scripts/run_studio.mjs --production --open",
    "start:studio:linux": "./scripts/run_studio_linux.sh",
    "start:studio:windows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run_studio.ps1",
    "stop:studio": "node ./scripts/stop_studio.mjs",
    "stop:studio:linux": "./scripts/stop_studio_linux.sh",
    "stop:studio:windows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop_studio.ps1",
    "build:web": "npm --workspace apps/web run build",
    "lint": "npm run lint:web && npm run lint:python && npm run lint:css && npm run lint:architecture",
    "lint:python": "node scripts/static-analysis/python.mjs",
    "lint:python:baseline": "node scripts/static-analysis/python.mjs --update-baseline",
    "test:static-analysis:python": "node scripts/static-analysis/python.mjs --test",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:web:baseline": "node scripts/static-analysis/gate.mjs --update-baseline",
    "test:static-analysis": "node --test scripts/static-analysis/gate.test.mjs scripts/static-analysis/custom-web.test.mjs",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "smoke:studio": "node ./scripts/smoke_studio_playwright.mjs",
    "smoke:assistant-layout": "node ./scripts/check_assistant_layout.mjs",
    "lint:css": "node scripts/static-analysis/css.mjs",
    "lint:css:baseline": "node scripts/static-analysis/css.mjs --update-baseline",
    "test:static-analysis:css": "node --test scripts/static-analysis/css.test.mjs",
    "lint:full": "npm run lint",
    "lint:architecture": "node scripts/static-analysis/full.mjs",
    "lint:architecture:baseline": "node scripts/static-analysis/full.mjs --update-baseline",
    "lint:changed": "node scripts/static-analysis/changed.mjs",
    "test:static-analysis:full": "node --test scripts/static-analysis/full.test.mjs",
    "test:web:focused": "node scripts/test-focused-web.mjs",
    "test:focused-harness": "node --test scripts/test-focused-web.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.57.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.1",
    "postcss": "8.5.26",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^3.2.7"
  }
}
